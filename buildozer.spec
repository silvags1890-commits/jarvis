[app]
title = J.A.R.V.I.S.
package.name = jarvis
package.domain = org.stark
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1
requirements = python3,flet,requests,urllib3,certifi,idna,charset-normalizer
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,RECORD_AUDIO
android.api = 33
android.minapi = 21
android.sdk = 33
android.ndk = 25b
android.accept_sdk_license = True
android.archs = arm64-v8a
icon.filename = 
presplash.filename = 

[buildozer]
log_level = 2
warn_on_root = 1
bin_dir = ./bin
